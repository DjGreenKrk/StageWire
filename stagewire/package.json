{
  "name": "stagewire-poc1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PoC-1: rdzeń, format i pionowy plaster (bez GUI). Nazwa robocza.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "bench": "node --experimental-strip-types bench/bench.ts",
    "cli": "node --experimental-strip-types src/cli.ts",
    "build:web": "npm run -s sync:greencrew -- --soft && npm run -s gen:validator && vite build",
    "tauri": "tauri",
    "build:app": "tauri build --no-bundle",
    "packs:validate": "node --experimental-strip-types src/cli.ts packs validate packs",
    "packs:new": "node --experimental-strip-types src/cli.ts packs new",
    "gen:validator": "node scripts/gen-validator.mjs",
    "pretest": "node scripts/sync-greencrew-ui.mjs --soft && npm run -s gen:validator",
    "sync:greencrew": "node scripts/sync-greencrew-ui.mjs",
    "check:greencrew": "node scripts/sync-greencrew-ui.mjs --check"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@types/node": "^22.0.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "fast-check": "^3.23.0",
    "fflate": "^0.8.2",
    "immer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "rbush": "^4.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
