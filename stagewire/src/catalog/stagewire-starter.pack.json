    "std/rj45": {
      "kind": "connector",
      "name": "RJ45"
    },
    "std/xlr-3": {
      "kind": "connector",
      "name": "XLR 3-pin"
    },
    "std/xlr-5": {
      "kind": "connector",
      "name": "XLR 5-pin"
    },
    "std/sdi-3g": {
      "kind": "signal",
      "name": "SDI 3G",
      "domain": "video",
      "color": "#2f7fd1",
      "prefix": "V"
    },
    "std/hdmi": {
      "kind": "signal",
      "name": "HDMI",
      "domain": "video",
      "color": "#6b6b6b",
      "prefix": "V"
    },
    "std/displayport": {
      "kind": "signal",
      "name": "DisplayPort",
      "domain": "video",
      "color": "#8b5fbf",
      "prefix": "V"
    },
    "std/ethernet": {
      "kind": "signal",
      "name": "Ethernet",
      "domain": "network",
      "color": "#2fa84f",
      "prefix": "N"
    },
    "std/dmx": {
      "kind": "signal",
      "name": "DMX512",
      "domain": "lighting",
      "color": "#d1a12f",
      "prefix": "D"
    },
    "std/audio-analog": {
      "kind": "signal",
      "name": "Audio analogowe (symetryczne)",
      "domain": "audio",
      "color": "#d1572f",
      "prefix": "A"
    },
