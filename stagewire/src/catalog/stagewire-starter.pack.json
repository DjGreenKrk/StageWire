      "kind": "cable",
      "name": "Koncentryk SDI",
      "endPairs": [
        [
          "std/bnc-75",
          "std/bnc-75"
        ]
      ],
      "carriesSignals": [
        "std/sdi-3g"
      ]
    },
    "std/cable-hdmi": {
      "kind": "cable",
      "name": "Kabel HDMI",
      "endPairs": [
        [
          "std/hdmi-a",
          "std/hdmi-a"
        ]
      ],
      "carriesSignals": [
        "std/hdmi"
      ]
    },
    "std/cable-dp": {
      "kind": "cable",
      "name": "Kabel DisplayPort",
      "endPairs": [
        [
          "std/dp",
          "std/dp"
        ]
      ],
      "carriesSignals": [
        "std/displayport"
      ]
    },
    "std/cable-cat6": {
      "kind": "cable",
      "name": "Kabel Cat6",
      "endPairs": [
        [
          "std/rj45",
          "std/rj45"
