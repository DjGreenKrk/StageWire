{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagewire.invalid/schema/project-1.0.0-draft.json",
  "title": "Stagewire project (project.json), format 1.0.0-draft",
  "description": "Normatywny schemat formatu dyskowego. Identyfikator obiektu jest kluczem mapy (S-01) i nie jest powtarzany w obiekcie. Nieznane pola są dozwolone i zachowywane (Z8).",
  "type": "object",
  "required": ["formatVersion", "id", "name", "settings", "registries", "definitions", "equipment", "connections", "cables"],
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string" },
    "meta": { "type": "object" },
    "settings": {
      "type": "object",
      "properties": {
        "defaultCableSlackMm": { "type": "number", "minimum": 0 },
        "stockCableLengthsMm": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "hideMountedDin": { "type": "boolean" }
      }
    },
    "registries": { "type": "object", "propertyNames": { "$ref": "#/$defs/registryKey" }, "additionalProperties": { "$ref": "#/$defs/registryEntry" } },
    "definitions": { "$ref": "#/$defs/idMap_definition" },
    "spaces": { "$ref": "#/$defs/idMap_any" },
    "zones": { "$ref": "#/$defs/idMap_any" },
    "cabinets": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/cabinet" } },
    "racks": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/rack" } },
    "stageObjects": { "$ref": "#/$defs/idMap_any" },
    "underlays": { "$ref": "#/$defs/idMap_any" },
    "passages": { "$ref": "#/$defs/idMap_any" },
    "groups": { "$ref": "#/$defs/idMap_any" },
    "equipment": { "$ref": "#/$defs/idMap_instance" },
    "placements": { "$ref": "#/$defs/idMap_any" },
    "connections": { "$ref": "#/$defs/idMap_connection" },
    "cables": { "$ref": "#/$defs/idMap_cable" },
    "views": { "$ref": "#/$defs/idMap_any" },
    "reportDefinitions": { "$ref": "#/$defs/idMap_any" },
    "suppressions": {
      "type": "array",
      "items": { "type": "object", "required": ["ruleId", "subject", "reason"], "properties": { "ruleId": { "type": "string" }, "subject": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } } }
    },
    "packing": { "type": "object" },
    "ext": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z]{2,5}_[0-9a-z]+$" },
    "registryKey": { "type": "string", "pattern": "^(std|user)/[0-9a-z][0-9a-z._-]*$" },
    "idMap_any": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "object" } },
    "idMap_definition": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/definition" } },
    "idMap_instance": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/instance" } },
    "idMap_connection": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/connection" } },
    "idMap_cable": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/cable" } },
    "registryEntry": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["connector", "signal", "cable"] },
        "name": { "type": "string" },
        "carriesSignals": { "type": "array", "items": { "$ref": "#/$defs/registryKey" } },
        "endPairs": { "type": "array", "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/registryKey" }, { "$ref": "#/$defs/registryKey" }], "minItems": 2, "maxItems": 2 } },
        "maxLengthMm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "definition": {
      "type": "object",
      "required": ["latestRevision", "revisions"],
      "properties": {
        "latestRevision": { "type": "integer", "minimum": 1 },
        "revisions": { "type": "object", "minProperties": 1, "propertyNames": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "$ref": "#/$defs/revision" } }
      }
    },
    "revision": {
      "type": "object",
      "required": ["manufacturer", "model", "category", "kind", "ports"],
      "properties": {
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "category": { "type": "string" },
        "kind": { "enum": ["physical", "virtual"] },
        "changeClass": { "enum": ["cosmetic", "structural"] },
        "ports": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/portDefinition" } },
        "internalLinks": {
          "type": "array",
          "items": { "type": "object", "required": ["kind"], "properties": { "a": { "$ref": "#/$defs/id" }, "b": { "$ref": "#/$defs/id" }, "members": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } }, "contact": { "type": "string" }, "kind": { "enum": ["passthrough", "loopthrough", "bridge", "jumper", "switched"] } } }
        },
        "placementLayer": { "enum": ["body", "busbar"] },
        "phaseOrder": { "type": "array", "items": { "type": "string" } }
      }
    },
    "portDefinition": {
      "type": "object",
      "required": ["label", "order", "connectorKey", "signalKeys", "direction", "capacity"],
      "properties": {
        "label": { "type": "string" },
        "order": { "type": "integer" },
        "connectorKey": { "$ref": "#/$defs/registryKey" },
        "signalKeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/registryKey" } },
        "direction": { "enum": ["in", "out", "io", "loop"] },
        "side": { "enum": ["left", "right", "top", "bottom", "auto"] },
        "capacity": { "type": "integer", "minimum": 1 },
        "terminal": {
          "type": "object",
          "properties": {
            "track": { "type": "string" },
            "at": { "type": "number", "minimum": 0 },
            "side": { "enum": ["top", "bottom"] },
            "wires": { "type": "object", "properties": { "minMm2": { "type": "number", "exclusiveMinimum": 0 }, "maxMm2": { "type": "number", "exclusiveMinimum": 0 }, "ferrule": { "enum": ["allowed", "required", "forbidden"] } } },
            "kind": { "enum": ["screw", "push-in", "spring", "comb-slot"] },
            "fits": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "cabinet": {
      "type": "object",
      "required": ["name", "widthMm", "heightMm", "rows", "modules"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "widthMm": { "type": "number", "minimum": 50 },
        "heightMm": { "type": "number", "minimum": 50 },
        "depthMm": { "type": "number", "exclusiveMinimum": 0 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 12 },
        "modules": { "type": "integer", "minimum": 1, "maximum": 72 },
        "notes": { "type": "string" },
        "asBlock": { "type": "boolean" },
        "rackUnits": { "type": "object", "required": ["heightU"], "properties": { "heightU": { "type": "integer", "minimum": 1, "maximum": 60 } } },
        "mount": { "type": "object", "required": ["rackId", "uStart", "face", "slot"], "properties": { "rackId": { "$ref": "#/$defs/id" }, "uStart": { "type": "integer", "minimum": 1 }, "face": { "enum": ["front", "rear"] }, "slot": { "enum": ["full", "left", "center", "right"] } } },
        "terminals": { "type": "array", "items": { "type": "object", "required": ["instanceId", "portId"], "properties": { "instanceId": { "$ref": "#/$defs/id" }, "portId": { "$ref": "#/$defs/id" }, "group": { "type": "string", "minLength": 1, "maxLength": 40 } } } }
      }
    },
    "rack": {
      "type": "object",
      "required": ["name", "units"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "units": { "type": "integer", "minimum": 1, "maximum": 60 },
        "widthIn": { "type": "number" },
        "depthMm": { "type": "number", "exclusiveMinimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "instance": {
      "type": "object",
      "required": ["definitionId", "definitionRevision", "name"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/id" },
        "definitionRevision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "zoneId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "supply": { "enum": ["owned", "rental", "client", "unknown"] },
        "portOverrides": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" } },
        "din": {
          "type": "object",
          "required": ["cabinetId", "row", "at"],
          "properties": { "cabinetId": { "$ref": "#/$defs/id" }, "row": { "type": "integer", "minimum": 1 }, "at": { "type": "integer", "minimum": 1 }, "layer": { "enum": ["body", "busbar"] } }
        },
        "plate": {
          "type": "object",
          "required": ["cabinetId", "x", "y"],
          "properties": { "cabinetId": { "$ref": "#/$defs/id" }, "x": { "type": "number" }, "y": { "type": "number" } }
        },
        "jumpers": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "mount": {
          "type": "object",
          "required": ["rackId", "uStart", "face", "slot"],
          "properties": {
            "rackId": { "$ref": "#/$defs/id" },
            "uStart": { "type": "integer", "minimum": 1 },
            "face": { "enum": ["front", "rear"] },
            "slot": { "enum": ["full", "left", "center", "right"] }
          }
        }
      }
    },
    "portRef": {
      "type": "object",
      "required": ["instanceId", "portId"],
      "properties": { "instanceId": { "$ref": "#/$defs/id" }, "portId": { "$ref": "#/$defs/id" } }
    },
    "connection": {
      "type": "object",
      "required": ["from", "to", "signalKey", "medium"],
      "properties": {
        "from": { "$ref": "#/$defs/portRef" },
        "to": { "$ref": "#/$defs/portRef" },
        "signalKey": { "$ref": "#/$defs/registryKey" },
        "medium": { "enum": ["physical", "wireless", "virtual"] },
        "cableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      },
      "if": { "properties": { "medium": { "enum": ["wireless", "virtual"] } }, "required": ["medium"] },
      "then": { "properties": { "cableId": { "type": "null" } } }
    },
    "cable": {
      "type": "object",
      "required": ["cableTypeKey", "lengthSource"],
      "properties": {
        "cableTypeKey": { "$ref": "#/$defs/registryKey" },
        "number": { "type": "string" },
        "lengthMm": { "type": "number", "exclusiveMinimum": 0 },
        "stockLengthMm": { "type": "number", "exclusiveMinimum": 0 },
        "lengthSource": { "enum": ["manual", "estimated", "unknown"] },
        "estimateBasis": { "type": "object" }
      }
    }
  }
}
