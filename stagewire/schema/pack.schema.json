{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagewire.local/schema/pack.schema.json",
  "title": "Pakiet urządzeń StageWire (stagewire-pack/1)",
  "description": "Schemat pomocniczy do podpowiedzi w edytorze (zmapuj go lokalnie, np. VS Code: json.schemas z fileMatch *.swpack.json; pakiet nie zawiera ścieżki do schematu). Pełna walidacja (odniesienia do złączy i sygnałów, konflikty rejestrów, kolizje identyfikatorów, wymagania co do źródła) jest w programie: `cli packs validate`. Pola nieznane są dozwolone (program zgłasza je jako ostrzeżenia).",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "version",
    "license",
    "devices"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "stagewire-pack/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Małe litery, cyfry, myślniki; np. \"moje-urzadzenia\""
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "Warunki użycia danych pakietu, np. \"własne (do użytku wewnętrznego)\""
    },
    "description": {
      "type": "string"
    },
    "registries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(std|user)/[0-9a-z][0-9a-z._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "enum": [
              "connector",
              "signal",
              "cable"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "endPairs": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "carriesSignals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      },
      "description": "Pusta lista dozwolona tylko w pakiecie samych rejestrów"
    },
    "enclosures": {
      "type": "array",
      "description": "Obudowy (szafy, rozdzielnice) jako szablony; po użyciu powstaje zwykła szafa projektu. Obudowa nie ma portów.",
      "items": {
        "$ref": "#/$defs/enclosure"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "required": [
        "key",
        "manufacturer",
        "model",
        "category",
        "ports",
        "source"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Stabilny klucz urządzenia w pakiecie; nie zmieniaj go po publikacji"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "np. \"wideo / kamery\"; część przed ukośnikiem wybiera ikonę"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "maxLength": 400,
          "description": "Własnymi słowami; bez kopiowania opisów katalogowych"
        },
        "kind": {
          "enum": [
            "physical",
            "virtual"
          ]
        },
        "dimensionsMm": {
          "type": "object",
          "required": [
            "width",
            "depth",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20000
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20000
            }
          }
        },
        "weightKg": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "powerW": {
          "type": "number",
          "minimum": 0,
          "maximum": 200000,
          "description": "Pobór typowy [W]"
        },
        "rackUnits": {
          "type": "object",
          "required": [
            "heightU",
            "widthFraction"
          ],
          "properties": {
            "heightU": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "widthFraction": {
              "enum": [
                1,
                0.5,
                0.33
              ]
            }
          },
          "description": "Tylko dla urządzeń do racka; urządzenie nierackowe pomija to pole"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "datasheet",
                "manual",
                "measured",
                "estimated",
                "generic",
                "custom"
              ]
            },
            "ref": {
              "type": "string",
              "description": "Dokument producenta: nazwa i wersja, numer lub adres. Wymagane dla datasheet i manual"
            },
            "note": {
              "type": "string"
            },
            "verified": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data, kiedy człowiek porównał dane ze źródłem. Bez niej dane są niezweryfikowane"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://\\S+$",
              "description": "Adres dokumentu (nie jest pobierany przez program)"
            },
            "hardwareRevision": {
              "type": "string",
              "minLength": 1,
              "description": "Wersja sprzętowa, np. \"rev B\""
            },
            "generated": {
              "type": "boolean",
              "description": "true: dane wytworzone automatycznie; nigdy nie są uznawane za zweryfikowane bez daty verified"
            }
          }
        },
        "powerMaxW": {
          "type": "number",
          "minimum": 0,
          "maximum": 200000,
          "description": "Pobór maksymalny [W], nie mniej niż powerW"
        },
        "dinModules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72,
          "description": "Szerokość na szynie DIN w modułach po 17,5 mm"
        },
        "internalLinks": {
          "type": "array",
          "description": "Połączenia wewnętrzne po kluczach portów: bridge (stały mostek, także grupa members), jumper (konfigurowalny), switched (zależny od stanu, nie scala węzłów), passthrough, loopthrough",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "passthrough",
                  "loopthrough",
                  "bridge",
                  "jumper",
                  "switched"
                ]
              },
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "contact": {
                "type": "string"
              }
            }
          }
        },
        "placementLayer": {
          "enum": [
            "body",
            "busbar"
          ],
          "description": "busbar = grzebień/mostek leżący na zaciskach aparatów"
        },
        "phaseOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Oczekiwana kolejność torów grzebienia, np. [\"L1\",\"L2\",\"L3\"]"
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "key",
        "label",
        "connector",
        "signals",
        "direction"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Stabilny klucz portu (z niego powstaje identyfikator używany przez połączenia); nie zmieniaj po publikacji"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "connector": {
          "type": "string",
          "description": "Klucz złącza z rejestru (np. std/bnc-75)"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "direction": {
          "enum": [
            "in",
            "out",
            "io",
            "loop"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "auto"
          ]
        },
        "note": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "description": "Nazwa grupy portów (np. \"Zasilanie\", \"Wejścia SDI\"); wskazówka porządkowa"
        },
        "electrical": {
          "type": "object",
          "description": "Parametry portu zasilania",
          "properties": {
            "voltageMinV": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "voltageMaxV": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "maxW": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            }
          }
        },
        "terminal": {
          "type": "object",
          "description": "Opis zacisku: tor, położenie na aparacie, przewody, zgodność mechaniczna",
          "properties": {
            "track": {
              "type": "string",
              "maxLength": 12
            },
            "at": {
              "type": "number",
              "minimum": 0,
              "maximum": 72,
              "description": "Moduły od lewej krawędzi aparatu"
            },
            "side": {
              "enum": [
                "top",
                "bottom"
              ]
            },
            "wires": {
              "type": "object",
              "properties": {
                "minMm2": {
                  "type": "number"
                },
                "maxMm2": {
                  "type": "number"
                },
                "ferrule": {
                  "enum": [
                    "allowed",
                    "required",
                    "forbidden"
                  ]
                }
              }
            },
            "kind": {
              "enum": [
                "screw",
                "push-in",
                "spring",
                "comb-slot"
              ]
            },
            "fits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "enclosure": {
      "type": "object",
      "required": [
        "key",
        "manufacturer",
        "model",
        "widthMm",
        "heightMm",
        "rows",
        "modules"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "widthMm": {
          "type": "number",
          "minimum": 50,
          "maximum": 5000
        },
        "heightMm": {
          "type": "number",
          "minimum": 50,
          "maximum": 5000
        },
        "depthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Liczba szyn DIN"
        },
        "modules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72,
          "description": "Moduły 17,5 mm na szynie"
        },
        "ip": {
          "type": "string"
        },
        "mounting": {
          "enum": [
            "surface",
            "flush",
            "wall",
            "floor"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object"
        }
      }
    }
  }
}
